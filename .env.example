# Copy this file to .env.local for local development, and add the same
# values as Environment Variables in the Vercel project settings for
# production.

# Resend API key, from resend.com after signing up.
RESEND_API_KEY=

# Where contact form submissions get sent. Comma-separate for multiple
# recipients, e.g. rachel@ark-team.com,kevin@ark-team.com,avner@ark-team.com
CONTACT_TO_EMAIL=

# Optional. Defaults to Resend's shared testing address, which works
# before a sending domain is verified. Once ark-team.com is verified in
# Resend, set this to something like "Ark Team <contact@ark-team.com>".
CONTACT_FROM_EMAIL=
